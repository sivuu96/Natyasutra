# Copy to .env for local development. Never commit .env.

# PostgreSQL connection. Use the psycopg driver.
DATABASE_URL=postgresql+psycopg://natya:natya@localhost:5432/natyasutra

# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:5173

# Set to "production" in AWS.
APP_ENV=development
